<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Upload to App Store Connect / TestFlight:
     xcodebuild -exportArchive -archivePath <xcarchive> -exportOptionsPlist tools/ExportOptions-TestFlight.plist \
       -exportPath <dir outside Dropbox> -allowProvisioningUpdates
     Uses the Apple ID signed in to Xcode. Bump CURRENT_PROJECT_VERSION in project.yml before every upload. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>TQJ35ER433</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
